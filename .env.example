# ───────── Veritabanı (Supabase Postgres) ─────────
# Uygulama çalışma zamanı bağlantısı — Supabase "Transaction" pooler (port 6543).
# postgres.js pooler ile prepared statement kullanamaz → ?prepare=false zorunlu.
DATABASE_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-0-<bolge>.pooler.supabase.com:6543/postgres?prepare=false"

# Migration/seed için doğrudan bağlantı (port 5432). drizzle-kit bunu kullanır.
DIRECT_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-0-<bolge>.pooler.supabase.com:5432/postgres"

# ───────── Oturum (session) ─────────
# `openssl rand -base64 32` veya benzeri ile üretilmiş rastgele gizli anahtar.
SESSION_SECRET=""

# ───────── Supabase Storage (görsel yükleme) ─────────
# Server tarafı yüklemeler için service role anahtarı (GİZLİ — asla client'a sızmamalı).
SUPABASE_URL="https://<proje-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Client tarafı (public) — görselleri okumak için.
NEXT_PUBLIC_SUPABASE_URL="https://<proje-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Storage bucket'ları (Supabase panelinden PUBLIC olarak oluşturulmalı):
#   listing-photos  → ilan görselleri
#   listing-videos  → ilan tanıtım videoları

# Not: Görsel boyutlandırma/WebP dönüşümü next/image ile yapılıyor (Vercel'in
# görsel optimizasyonu). Supabase'in ÜCRETLİ image transformation özelliğine
# ihtiyaç yok. next.config.ts, NEXT_PUBLIC_SUPABASE_URL'deki host'u
# images.remotePatterns'e ekler — bu değişken TANIMLI OLMALI, aksi halde
# uzak görseller next/image tarafından reddedilir.

# ───────── E-posta (şifre sıfırlama + bildirim e-postaları — Resend) ─────────
# https://resend.com → API Keys. Tanımlı değilse bildirim e-postası sessizce atlanır.
# E-postadaki bağlantılar NEXT_PUBLIC_SITE_URL'e, yoksa Vercel'in üretim alan adına gider.
RESEND_API_KEY=""
# Doğrulanmış gönderici adresi. Örn: AĞIRKİRALA <no-reply@alanadiniz.com>
EMAIL_FROM=""

# Şifre sıfırlama linkinin mutlak adresi. Boşsa istek başlıklarından türetilir.
NEXT_PUBLIC_SITE_URL=""

# ───────── Mobil uygulama (/api/v1) ─────────
# GET /api/v1/config bunları döner. İstemci kendi sürümünü minSupportedVersion ile
# kıyaslar ve küçükse zorunlu güncelleme ekranı gösterir. Mobilde eski bir sürüm
# aylarca istek atmaya devam edebildiği için bu bayraklar tek uzaktan kumandadır.
API_MIN_VERSION_IOS="1.0.0"
API_MIN_VERSION_ANDROID="1.0.0"

# "1" yapılırsa istemci bakım ekranına düşer.
API_MAINTENANCE=""
API_MAINTENANCE_MESSAGE=""

# Zorunlu güncelleme ekranındaki mağaza bağlantıları.
STORE_URL_APP_STORE=""
STORE_URL_PLAY_STORE=""

# ───────── Push bildirimleri (Firebase Cloud Messaging, HTTP v1) ─────────
# Flutter FCM token'ini POST /api/v1/device-tokens ile kaydeder; token oturuma
# baglidir (device_tokens). Anahtarlar tanimli degilse bildirim sessizce atlanir.
# Kaynak: Firebase Console → Project settings → Service accounts →
# "Generate new private key" ile inen JSON'daki project_id / client_email / private_key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# GIZLI. Tek satir, satir sonlari \n kacisiyla: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# ───────── Sesli arama (LLM yedeği) ─────────
# Istege bagli. Sesli aramada cumle sozlukle anlasilamazsa Claude Haiku ile
# ikinci deneme yapilir. Tanimli degilse yalniz kural tabanli esleme calisir;
# arama yine calisir (gelistirme ve testler anahtar gerektirmez).
ANTHROPIC_API_KEY=""

# ───────── Testler ─────────
# vitest ZORUNLU olarak bunu ister ve DATABASE_URL'e kopyalar. Ayrı bir bağlantı
# dizesi olması bilinçli bir bariyerdir: testler tablolara yazıp siliyor,
# geliştirme/üretim veritabanına kazara koşmaları felaket olurdu.
# Örn: postgres://postgres:postgres@localhost:5432/avk_test
TEST_DATABASE_URL=""
